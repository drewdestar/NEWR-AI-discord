# Copy to .env and fill in. NEVER commit .env or share tokens/keys in chat.
DISCORD_TOKEN=
# NEWR LABS guild (verified server, guild-synced slash commands)
# Also the guild checked by the AI membership gate in verify.py.
GUILD_ID=1465422166790242377
# Optional invite link shown to non-members by the gate. Leave empty
# if there is none — the bot never invents an invite URL.
GUILD_INVITE_URL=
# OpenAI-compatible AI provider. Change only the URL/model to switch provider.
# FREE AI provider (free tiers only, no paid key required). Default: OpenRouter free tier.
# Groq free: https://api.groq.com/openai/v1 + llama-3.3-70b-versatile
# Gemini free: https://generativelanguage.googleapis.com/v1beta/openai + gemini-2.0-flash
# Hugging Face free inference exists, but OpenAI-compatible support varies; prefer the three above.
# Free tiers have rate limits and model names change — check the provider model list if a model 404s.
AI_API_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=meta-llama/llama-3.1-8b-instruct:free
DB_PATH=data.db
# Shared brain: ONE memory.db for BOTH bots. Leave the default
# (shared-brain/memory.db next to memory.py) or set the SAME path
# here for both bots. Never put a token/key in this file.
SHARED_BRAIN_DB=/home/hatch/workspace/bots/shared-brain/memory.db
